# Copy to .env.local and fill in. Never commit real values — .env* is gitignored.

# ---------------------------------------------------------------------------
# Database — Turso (libSQL)
# ---------------------------------------------------------------------------
# Leave TURSO_DATABASE_URL unset (or blank) to use a local SQLite file instead,
# which is what development and the test suites do. Blank counts as unset; see
# lib/db/url.ts.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional. Path used only when TURSO_DATABASE_URL is unset. Defaults to data/app.db.
DATABASE_PATH=

# ---------------------------------------------------------------------------
# Session + admin
# ---------------------------------------------------------------------------
# At least 32 characters. Rotating this signs out every user and invalidates any
# in-flight signup, so do it before real users exist rather than after.
IRON_SESSION_PASSWORD=
# Used once, by `npm run db:seed`, to create the admin account.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Email — Brevo. REQUIRED IN PRODUCTION.
# ---------------------------------------------------------------------------
# Verification codes are emailed; they are never returned to the browser. With
# BREVO_API_KEY unset outside production the code is written to the SERVER log
# instead, so the signup flow works offline. In production a missing key makes
# signup fail loudly rather than silently dropping mail, because a no-op mailer
# would leave every new user permanently unable to verify.
BREVO_API_KEY=
# Must be a sender you have VERIFIED in Brevo (Senders, Domains & Dedicated IPs
# → Senders). An unverified sender is rejected by the API no matter how valid
# the key is.
BREVO_SENDER_EMAIL=
# Display name shown beside the address. No quotes — dotenv keeps them.
BREVO_SENDER_NAME=

# ---------------------------------------------------------------------------
# Google sign-in (Google Cloud → APIs & Services → Credentials → OAuth client)
# ---------------------------------------------------------------------------
# The "Continue with Google" button stays hidden until GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No trailing slash. The OAuth redirect URI is built from it as
# ${APP_BASE_URL}/api/auth/google/callback, and /api/events checks Origin
# against it.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public by design, not a secret. Unset renders a thank-you with no link.
NEXT_PUBLIC_DONATE_URL=

# Disables rate limiting. For the E2E suite only — IGNORED when NODE_ENV is
# production, so it cannot weaken a deployment. Do not set it by hand.
RATE_LIMIT_DISABLED=
